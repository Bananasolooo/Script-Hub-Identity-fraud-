-- BOTÃO CLEAN FRAUD
local FraudBtn = createButton(ExtrasCard, "🚫 Clean Fraud Vision", Colors.Danger)
FraudBtn.Size = UDim2.new(1, -16, 0, 28)

FraudBtn.MouseButton1Click:Connect(function()
    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        local fraudNPC = npcsFolder:FindFirstChild("Fraud")
        if fraudNPC then
            local head = fraudNPC:FindFirstChild("Head")
            local torso = fraudNPC:FindFirstChild("Torso")
            
            if head and head:IsA("BasePart") then 
                head.Transparency = 1 
                local face = head:FindFirstChildOfClass("Decal")
                if face then face.Transparency = 1 end
            end
            if torso and torso:IsA("BasePart") then torso.Transparency = 1 end
            
            for _, item in ipairs(fraudNPC:GetChildren()) do
                if item:IsA("Accessory") then item:Destroy() end
            end
            
            FraudBtn.Text = "✔️ Vision Cleaned!"
            FraudBtn.BackgroundColor3 = Colors.Success
            task.wait(1.5)
            FraudBtn.Text = "🚫 Clean Fraud Vision"
            FraudBtn.BackgroundColor3 = Colors.Danger
        else
            FraudBtn.Text = "❌ 'Fraud' not found"
            task.wait(1.5)
            FraudBtn.Text = "🚫 Clean Fraud Vision"
        end
    else
        FraudBtn.Text = "❌ 'NPCs' missing"
        task.wait(1.5)
        FraudBtn.Text = "🚫 Clean Fraud Vision"
    end
end)

