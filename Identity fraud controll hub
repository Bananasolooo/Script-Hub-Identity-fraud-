-- TOGGLE ANTI-VOID
local AntiVoidBtn = createButton(ExtrasCard, "🛡️ ANTI-VOID: OFF", Colors.InputBg)
AntiVoidBtn.Size = UDim2.new(1, -16, 0, 28)

AntiVoidBtn.MouseButton1Click:Connect(function()
    _G.AntiVoid_Enabled = not _G.AntiVoid_Enabled
    
    if _G.AntiVoid_Enabled then
        AntiVoidBtn.Text = "🛡️ ANTI-VOID: ON"
        AntiVoidBtn.BackgroundColor3 = Colors.Warning
        
        task.spawn(function()
            local Y_LIMIT = -46.419
            local TP_DESTINATION = Vector3.new(506.219, 5, -516.763)
            local isTeleporting = false
            
            while _G.AntiVoid_Enabled do
                task.wait(0.05)
                
                if not LocalPlayer.Character then continue end
                local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not rootPart then continue end
                
                local currentY = rootPart.Position.Y
                if currentY <= Y_LIMIT and not isTeleporting then
                    isTeleporting = true
                    rootPart.CFrame = CFrame.new(TP_DESTINATION)
                    rootPart.Anchored = true
                    
                    task.spawn(function()
                        task.wait(5)
                        if rootPart and rootPart.Parent then 
                            rootPart.Anchored = false 
                        end
                        isTeleporting = false
                    end)
                end
            end
        end)
        
    else
        AntiVoidBtn.Text = "🛡️ ANTI-VOID: OFF"
        AntiVoidBtn.BackgroundColor3 = Colors.InputBg
    end
end)

-- ==========================================
-- 8. ENGINE LOOP (SPEED/TELEPORT)
-- ==========================================
task.spawn(function()
    while task.wait(0.1) do
        if not UI or not UI.Parent then break end
        
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.WalkSpeed ~= _G.WalkSpeedValue then
                    hum.WalkSpeed = _G.WalkSpeedValue
                end
                
                if _G.TargetTeleportPos then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.AssemblyLinearVelocity = Vector3.zero
                        char:PivotTo(CFrame.new(_G.TargetTeleportPos))
                        _G.TargetTeleportPos = nil
                    end
                end
            end
        end)
    end
end)
