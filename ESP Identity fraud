-- =====================================================================
-- [[ ESP IDENTITY FRAUD - SEM LOOP (EXECUÇÃO ÚNICA) ]]
-- =====================================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local localSeguro
local ok, coregui = pcall(function() return game:GetService("CoreGui") end)
if ok and coregui then
    localSeguro = coregui
else
    localSeguro = LocalPlayer:WaitForChild("PlayerGui")
end

local nomesMonstros = {
    ["fraud"] = true,
    ["stan"] = true,
    ["ralph"] = true,
    ["alice"] = true,
    ["frag"] = true,
    ["massacre"] = true,
    ["identity"] = true
}

local function limparESPTotal()
    if _G.Delta_ESP_Folder then
        _G.Delta_ESP_Folder:Destroy()
        _G.Delta_ESP_Folder = nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hl = p.Character:FindFirstChild("Delta_BordaHighlight")
            if hl then hl:Destroy() end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        local hl = obj:FindFirstChild("Delta_BordaHighlight")
        if hl then hl:Destroy() end
    end
end

-- Limpa execuções antigas antes de aplicar a nova
limparESPTotal()

local espFolder = Instance.new("Folder")
espFolder.Name = "Delta_ESP_System"
espFolder.Parent = localSeguro
_G.Delta_ESP_Folder = espFolder

local function aplicarEfeitoESP(char, nomeExibido, cor)
    local head = char:FindFirstChild("Head")
    
    if head then
        -- 1. Criação do Texto
        local tagId = char.Name .. "_Tag"
        local tag = Instance.new("BillboardGui")
        tag.Name = tagId
        tag.AlwaysOnTop = true
        tag.Size = UDim2.new(0, 100, 0, 30)
        tag.StudsOffset = Vector3.new(0, 3, 0)
        tag.Adornee = head
        tag.Parent = espFolder

        local label = Instance.new("TextLabel", tag)
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.Text = nomeExibido
        label.TextColor3 = cor
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        label.TextStrokeTransparency = 0

        -- 2. Criação da Borda
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "Delta_BordaHighlight"
            hl.OutlineColor = cor
            hl.OutlineTransparency = 0
            hl.FillTransparency = 1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = char
        end)
    end
end

-- PARTE 1: Escaneia Jogadores Reais (Cor Branca)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer and p.Character then
        aplicarEfeitoESP(p.Character, p.Name, Color3.new(1, 1, 1))
    end
end

-- PARTE 2: Escaneia Monstros do Labirinto (Cor Vermelha)
for _, obj in ipairs(Workspace:GetChildren()) do
    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= LocalPlayer.Character then
        local nomeMinusculo = string.lower(obj.Name)
        if nomesMonstros[nomeMinusculo] then
            aplicarEfeitoESP(obj, obj.Name:upper() .. " [MONSTRO]", Color3.new(1, 0, 0))
        end
    end
end
